msgid "Several devices report the same serial number; it is not used to identify them."
msgstr "여러 장치가 같은 일련번호를 보고합니다. 이 번호는 식별에 사용되지 않습니다."

msgid "No usable serial number or WWN: this device's identity cannot be confirmed."
msgstr "사용할 수 있는 일련번호나 WWN이 없어 이 장치의 신원을 확인할 수 없습니다."

msgid "The disk holding the running system could not be determined. All devices are treated as possibly in use by the system."
msgstr "실행 중인 시스템이 있는 디스크를 확인할 수 없습니다. 모든 장치를 시스템이 사용 중일 수 있는 것으로 취급합니다."

msgid "Virtual block devices (loop, device-mapper, RAID) are not listed."
msgstr "가상 블록 장치(loop, device-mapper, RAID)는 표시하지 않습니다."

msgid "Device discovery is not implemented for this operating system in this build."
msgstr "이 빌드에는 이 운영체제용 장치 검색이 구현되어 있지 않습니다."

msgid "Permission denied while listing storage devices."
msgstr "저장 장치 목록을 읽는 중 권한이 거부되었습니다."

msgid "The list of storage devices could not be read."
msgstr "저장 장치 목록을 읽을 수 없습니다."

msgid "Simulated discovery failure."
msgstr "시뮬레이션된 검색 실패입니다."

msgid "Device discovery stopped unexpectedly."
msgstr "장치 검색이 예기치 않게 중단되었습니다."

msgid "The background discovery worker is not running."
msgstr "백그라운드 검색 작업자가 실행 중이 아닙니다."

